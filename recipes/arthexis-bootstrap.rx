# Bootstrap and keep a persistent managed Arthexis Watchtower on the live runner.
# Re-running this recipe is intentionally non-destructive: Arthexis managed install
# is idempotent and preserves the persistent instance state under /opt/arthexis/var.
# Parameters: log_destination

log --tags watchtower,ubuntu22 --to [log_destination]
install arthexis --service --role Watchtower
arthexis status --json
arthexis good
